┌Keys──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
│q        quit                                                                                                                                                 │
│j/k ↓/↑  move                                                                                                                                                 │
│h/l Tab  focus column                                                                                                                                         │
│p        open pull request                                                                                                                                    │
│b        open build                                                                                                                                           │
│y/Y      copy pull request / build URL                                                                                                                        │
│d        details                                                                                                                                              │
│z        zoom the column                                                                                                                                      │
│Esc      leave zoom                                                                                                                                           │
│/        filter                                                                                                                                               │
│r        refresh                                                                                                                                              │
│R        refresh all                                                                                                                                          │
│?        this help                                                                                                                                            │
└──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
any key returns
